import matplotlib.pyplot as plt
import numpy as np


def funcao(x):
    return x**3 - x - 2

def encontrar_raiz(maior, menor, precisao=1e-4):
    meio = (maior + menor) / 2 
    print(f"O valor médio é: {meio}")

    y = funcao(meio)
    print(f"O valor de f(meio) é: {y}")
    
    
    if abs(y) < precisao:
        return meio

    
    if y > 0:
        return encontrar_raiz(meio, menor, precisao)
    elif y < 0:
        return encontrar_raiz(maior, meio, precisao)
    
while True:
    try:
        maior = float(input("Digite o maior valor do intervalo: "))
        menor = float(input("Digite o menor valor do intervalo: "))

        
        if funcao(maior) * funcao(menor) > 0:
            print("Esse intervalo não tem raízes. Tente novamente.")
            continue

        raiz = encontrar_raiz(maior, menor)
        print(f"Dentro desse intervalo existe uma raiz no valor de x ≈ {raiz:.4f}")
        break

    except ValueError:
        print("Entrada inválida. Por favor, insira números.")