class ArvoreGenealogica:
    def __init__(self):
        self.membros = []

    def adicionar_membro(self, nome, idade, sexo, pai=None):
        novo_membro = {"nome": nome, "idade": idade, "sexo": sexo, "filhos": []}
        
        if pai is None:
            self.membros.append(novo_membro)
        else:
            membro_pai = self.buscar_membro(pai)
            if membro_pai:
                membro_pai['filhos'].append(novo_membro)
            else:
                print(f"Erro: Pai {pai} não encontrado.")
    
    def buscar_membro(self, nome):
        for membro in self.membros:
            resultado = self._buscar_membro_recursivo(membro, nome)
            if resultado:
                return resultado
        return None

    def _buscar_membro_recursivo(self, membro, nome):
        if membro['nome'] == nome:
            return membro
        for filho in membro['filhos']:
            resultado = self._buscar_membro_recursivo(filho, nome)
            if resultado:
                return resultado
        return None
    
    def descendentes(self, nome):
        membro = self.buscar_membro(nome)
        if membro:
            return self._descendentes_recursivo(membro)
        else:
            print(f"Membro {nome} não encontrado.")
            return []

    def _descendentes_recursivo(self, membro):
        descendentes = []
        for filho in membro['filhos']:
            descendentes.append(filho['nome'])
            descendentes.extend(self._descendentes_recursivo(filho))
        return descendentes