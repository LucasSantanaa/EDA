class ArvoreGenealogica:
    def __init__(self):
        self.membros = []

    def adicionar_membro(self, nome, idade, sexo, pai=None):
        novo_membro = {"nome": nome, "idade": idade, "sexo": sexo, "filhos": []}
        
        if pai is None:
            self.membros.append(novo_membro)
        else:
            membro_pai = self.buscar_membro(pai)
            if membro_pai:
                membro_pai['filhos'].append(novo_membro)
            else:
                print(f"Erro: Pai {pai} não encontrado.")
    
    def buscar_membro(self, nome):
        for membro in self.membros:
            resultado = self._buscar_membro_recursivo(membro, nome)
            if resultado:
                return resultado
        return None

    def _buscar_membro_recursivo(self, membro, nome):
        if membro['nome'] == nome:
            return membro
        for filho in membro['filhos']:
            resultado = self._buscar_membro_recursivo(filho, nome)
            if resultado:
                return resultado
        return None
    
    def descendentes(self, nome):
        membro = self.buscar_membro(nome)
        if membro:
            return self._descendentes_recursivo(membro)
        else:
            print(f"Membro {nome} não encontrado.")
            return []

    def _descendentes_recursivo(self, membro):
        descendentes = []
        for filho in membro['filhos']:
            descendentes.append(filho['nome'])
            descendentes.extend(self._descendentes_recursivo(filho))
        return descendentes
    
    def antepassados(self, nome):
        for membro in self.membros:
            caminho_antepassados = self._antepassados_recursivo(membro, nome)
            if caminho_antepassados:
                return caminho_antepassados
        return []

    def _antepassados_recursivo(self, membro, nome, caminho=None):
        if caminho is None:
            caminho = []
        
        for filho in membro['filhos']:
            if filho['nome'] == nome:
                caminho.append(membro['nome'])
                return caminho
            
            resultado = self._antepassados_recursivo(filho, nome, caminho)
            if resultado:
                caminho.append(membro['nome'])
                return caminho
        
        return None
    
arvore = ArvoreGenealogica()


arvore.adicionar_membro("João", 70, "M")
arvore.adicionar_membro("Carlos", 50, "M", "João")
arvore.adicionar_membro("Pedro", 30, "M", "Carlos")
arvore.adicionar_membro("Lucas", 10, "M", "Pedro")


print("Descendentes de João:", arvore.descendentes("João"))


print("Antepassados de Lucas:", arvore.antepassados("Lucas"))